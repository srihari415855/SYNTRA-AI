# AI Model-Routing & Tool-Use System Configuration

# Environment mode: development, testing, production
ENVIRONMENT=development
DEBUG=true

# API Server
API_HOST=127.0.0.1
API_PORT=8000
API_TITLE="AI Model-Routing System"
API_VERSION="0.1.0"

# Local LLM Runtime (Ollama / Compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gemma-4-e4b
CODING_MODEL=qwen2.5-coder:7b
REASONING_MODEL=qwen3:8b
COMPLEX_REASONING_MODEL=deepseek-r1:8b

# Fallback & Mock options
USE_MOCK_FALLBACK_ON_OLLAMA_OFFLINE=true
OLLAMA_TIMEOUT_SECONDS=60.0

# Orchestrator & Loop Guards
MAX_CALL_DEPTH=5
TOOL_EXECUTION_TIMEOUT_SECONDS=15.0

# Tenacity Retry Settings
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT_SECONDS=1.0
RETRY_MAX_WAIT_SECONDS=8.0
RETRY_JITTER_SECONDS=1.0

# Database Persistence (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./ai_system.db
SQL_ECHO=false
